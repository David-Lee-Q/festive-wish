# ===== 节日祝福生成器 环境变量 =====
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略
# 所有模型调用均由后端代理，前端无法获取以下信息

# 模型服务地址（OpenAI 兼容）
MODEL_BASE_URL=https://gpt.cosmoplat.com/v1

# 服务端密钥（严禁暴露给前端）
MODEL_API_KEY=your-api-key-here

# 文本生成模型
MODEL_TEXT=cosmo-mind-nothink

# 文生图模型
MODEL_IMAGE=cosmo-mind-image

# 服务端口
PORT=3000
